{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noUnusedLocals": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "types": ["node"],
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "noEmit": true
    },
    "include": ["src/**/*", "electron.vite.config.ts", "vitest.config.mts"]
}
