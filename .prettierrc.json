{
    "tabWidth": 4,
    "useTabs": false,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none",
    "printWidth": 120,
    "endOfLine": "lf",
    "embeddedLanguageFormatting": "off",
    "overrides": [
        {
            "files": "*.md",
            "options": {
                "embeddedLanguageFormatting": "auto"
            }
        }
    ]
}
