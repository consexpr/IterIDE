# Only project inputs belong in the public repository.
/*
!/.clang-format
!/.editorconfig
!/.gitattributes
!/.gitignore
!/.prettierignore
!/.prettierrc.json
!/README.md
!/LICENSE
!/CONTRIBUTING.md
!/THIRD_PARTY_NOTICES.md
!/.github/
!/app/
!/docs/

/app/*
!/app/.gitignore
!/app/package.json
!/app/package-lock.json
!/app/tsconfig.json
!/app/electron.vite.config.ts
!/app/electron-builder.yml
!/app/vitest.config.mts
!/app/src/
!/app/scripts/
!/app/docs/
!/app/resources/
!/app/plugins/

/app/resources/*
!/app/resources/model/
!/app/resources/runner/
!/app/resources/sdk/
!/app/resources/testlib/

/docs/*
!/docs/THEMES.md
!/docs/theme-examples/
/app/docs/maintenance-*.md
/app/docs/model-v2-design.md
/app/docs/model-v2/

# Generated output, local profiles, editor state and credentials.
**/node_modules/
**/.cache/
**/out/
**/dist/
**/coverage/
**/test-results/
**/.backups/
**/.idea/
**/.vscode/
**/__pycache__/
*.log
*.tmp
*.bak
*.orig
*.rej
*.zip
*.7z
*.exe
*.dll
*.pdb
*.tsbuildinfo
.env
.env.*
!.env.example
*.pem
*.pfx
*.p12
*.key
.DS_Store
Thumbs.db
